---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // Astro bundles this script for the browser; no localStorage is accessed during SSR.
  import { nextSlug, normalizeUrl, parseBookmarks } from '../lib/bookmarks.mjs';

  const STORAGE_KEY = 'mona-bookmarks-v1';
  const COUNTER_KEY = 'mona-bookmark-counter-v1';
  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const field = document.querySelector<HTMLInputElement>('#url');
  const list = document.querySelector<HTMLUListElement>('#bookmark-list');
  const empty = document.querySelector<HTMLElement>('#empty-state');
  const header = document.querySelector<HTMLElement>('#list-header');
  const clear = document.querySelector<HTMLButtonElement>('#clear-all');

  function readStorage(key: string): string | null {
    try { return localStorage.getItem(key); } catch { return null; }
  }
  function writeStorage(key: string, value: string) {
    try { localStorage.setItem(key, value); }
    catch { window.alert('Browser storage is unavailable; bookmarks will not survive a reload.'); }
  }

  let bookmarks = parseBookmarks(readStorage(STORAGE_KEY));
  function save() { writeStorage(STORAGE_KEY, JSON.stringify(bookmarks)); }

  function render() {
    if (!list || !empty || !header) return;
    list.replaceChildren();
    for (const item of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';
      const a = document.createElement('a');
      a.className = 'url';
      a.href = item.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = item.url;
      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = item.slug;
      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', 'Copy ' + item.slug);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(item.slug);
          copy.textContent = 'Copied';
        } catch {
          copy.textContent = 'Copy unavailable';
        }
      });
      li.append(a, slug, copy);
      list.append(li);
    }
    empty.hidden = bookmarks.length > 0;
    header.hidden = bookmarks.length === 0;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!field) return;
    let url: string;
    try { url = normalizeUrl(field.value); }
    catch (error) {
      field.setCustomValidity(error instanceof Error ? error.message : 'Invalid URL');
      field.reportValidity();
      return;
    }
    field.setCustomValidity('');
    const storedCounter = Number(readStorage(COUNTER_KEY));
    let counter = Number.isSafeInteger(storedCounter) && storedCounter >= 0 ? storedCounter : 0;
    const used = new Set(bookmarks.map(bookmark => bookmark.slug));
    let slug: string;
    do { slug = nextSlug(++counter); } while (used.has(slug));
    bookmarks.push({ url, slug });
    writeStorage(COUNTER_KEY, String(counter));
    save();
    render();
    form.reset();
    field.focus();
  });

  field?.addEventListener('input', () => field.setCustomValidity(''));
  clear?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    save();
    render();
  });

  render();
</script>
